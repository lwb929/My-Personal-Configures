{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/instructions/style.md"
  ],
  "disabled_providers": [],
  "provider": {
    "cc-proxy": {
      "name": "Command Code Proxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:3050/v1",
        "apiKey": "REDACTED-USE-ENV-VAR"
      },
      "models": {
