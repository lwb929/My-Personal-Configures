      "name": "227-2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.4:227/v1"
      },
      "models": {
        "oc/deepseek-v4-flash-free": {
          "name": "oc/deepseek-v4-flash-free"
        }
      }
    }
  },
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "opencode_mcp": {
        "type": "local",
        "command": [
          "node",
          "~/WORKPLACE/mcp-opencode/dist/index.js"
        ],
        "environment": {
          "MCP_OPENCODE_MODEL": "kilo/kilo-auto/free",
          "MCP_OPENCODE_MODEL_FALLBACK": "cc-proxy/gpt-5.6-luna,zai-coding-plan/glm-5.3"
        }
      },
      "rea": {
        "type": "local",
        "command": [
          "~/.nvm/versions/node/v24.22.1/bin/node",
          "~/WORKPLACE/OpenSourceProject/rea/scripts/rea.mjs",
          "mcp"
        ],
        "environment": {
          "REA_JADX_MCP_JAR": "~/WORKPLACE/OpenSourceProject/rea/third_party/jadx-headless-mcp/build/libs/jadx-headless-mcp-0.7.1-all.jar",
          "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64"
        },
        "disabled": false
      },
      "browser-control": {
        "type": "local",
        "command": [
          "node",
          "~/.nvm/versions/node/v24.19.0/lib/node_modules/@opencode-ai/browser-control/dist/mcp.js"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier",
    "opencode-auto-resume",
    "~/.config/opencode/plugins/oc-toolkit"
  ]
}
