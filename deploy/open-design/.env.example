# ===== 镜像 =====
# 固定版本更稳；想跟最新用 :latest
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:0.27.1

# ===== 监听 =====
# 宿主机绑定地址：内网/反代场景保持 127.0.0.1，由反代或 SSH 隧道进入
OPEN_DESIGN_BIND=127.0.0.1
OPEN_DESIGN_PORT=7456

# 浏览器 Origin 白名单：只有走域名/公网反代时才需要填，必须写精确 origin
# 例：https://od.example.com,http://203.0.113.10:7456
OPEN_DESIGN_ALLOWED_ORIGINS=

# ===== 认证 =====
# 必填。生成：openssl rand -hex 32
# 浏览器登录：用户名 open-design / 密码 此 token
OD_API_TOKEN=

# 仅当反代已完成认证、且 daemon 只经该反代可达时设为 1（会关闭 /api/* 的 Bearer 校验）
OPEN_DESIGN_DISABLE_API_AUTH=

# ===== 资源 =====
OPEN_DESIGN_MEM_LIMIT=1536m
NODE_OPTIONS=--max-old-space-size=768

# ===== 可选：BYOK 模型 key（不填也能启动，但无法生成内容）=====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# 仅当容器内 Codex 报 workspace-write 沙箱错误时设 danger-full-access
OD_CODEX_SANDBOX=
