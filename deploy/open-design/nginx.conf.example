# 宿主原生 Nginx 反代示例
# 放置：/etc/nginx/sites-available/open-design
# 启用：ln -s /etc/nginx/sites-available/open-design /etc/nginx/sites-enabled/
#       nginx -t && systemctl reload nginx
# 前置：.env 里 OPEN_DESIGN_ALLOWED_ORIGINS=https://od.example.com

server {
    listen 80;
    server_name od.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name od.example.com;

    ssl_certificate     /etc/letsencrypt/live/od.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/od.example.com/privkey.pem;

    client_max_body_size 200m;   # 上传设计稿 ZIP / 图片

    location / {
        proxy_pass http://127.0.0.1:7456;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE：聊天/生成流式输出必须关闭缓冲
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
