export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
 

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

. "$HOME/.local/bin/env"
export PATH="$HOME/platform-tools:$PATH"


# pi-web (PI WEB) - put its global bin on PATH for quick command use
for __piweb in "$HOME"/.nvm/versions/node/*/bin/pi-web; do :; done
if [ -n "$__piweb" ]; then
    pathprepend() { export PATH="$1:$PATH"; }
    pathprepend "$(dirname "$__piweb")"
    unset -f pathprepend 2>/dev/null
fi
unset __piweb

# Android SDK / NDK
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/android-ndk-r30"
export ANDROID_NDK_ROOT="$ANDROID_NDK_HOME"
export PATH="$ANDROID_NDK_HOME:$PATH"

