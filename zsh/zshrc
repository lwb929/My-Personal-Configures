# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh
# 基础文件操作（避免误删、增强可读性）
alias ls='eza -l --icons'
alias ll='eza -la --icons'
alias la='eza -a --icons'
alias lt='eza --tree --level=3'
# 安全操作（覆盖文件时提示确认）
alias rm='rm -i'            # 删除前确认
alias cp='cp -i'            # 复制前确认
alias mv='mv -i'            # 移动前确认
 
# 系统状态查看
alias df='df -h'            # 显示磁盘空间（人类可读单位：GB/MB）
alias du='du -h'            # 显示目录大小
alias free='free -h'        # 显示内存使用（需安装 free 工具）
 
# Git 常用命令简化（后续插件会进一步增强）
alias g='git'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'



####proxy
proxy_on() {
  export http_proxy="http://127.0.0.1:10808"
  export https_proxy="http://127.0.0.1:10808"
  export all_proxy="socks5://127.0.0.1:10808"

  export HTTP_PROXY="$http_proxy"
  export HTTPS_PROXY="$https_proxy"
  export ALL_PROXY="$all_proxy"

  echo "Proxy enabled: http://127.0.0.1:10808"
}

proxy_off() {
  unset http_proxy
  unset https_proxy
  unset all_proxy
  unset HTTP_PROXY
  unset HTTPS_PROXY
  unset ALL_PROXY

  echo "Proxy disabled"
}

cproxy_on() {
  export http_proxy="http://127.0.0.1:12345"
  export https_proxy="http://127.0.0.1:12345"
